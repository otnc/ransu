{
  "name": "ransu",
  "version": "0.0.0",
  "description": "Convenient and easy-to-use random functions.",
  "keywords": [
    "random",
    "prng",
    "rng",
    "seed",
    "seedable",
    "shuffle",
    "sample",
    "weighted",
    "uuid",
    "uuidv4",
    "uuidv7",
    "ulid",
    "nanoid",
    "xoshiro",
    "pcg",
    "mersenne-twister",
    "chacha20",
    "csprng",
    "typescript"
  ],
  "homepage": "https://github.com/otnc/ransu#readme",
  "bugs": {
    "url": "https://github.com/otnc/ransu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/ransu.git"
  },
  "license": "MIT",
  "author": "otoneko.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./compat": {
      "types": {
        "import": "./dist/compat.d.mts",
        "require": "./dist/compat.d.cts"
      },
      "import": "./dist/compat.mjs",
      "require": "./dist/compat.cjs"
    },
    "./distributions": {
      "types": {
        "import": "./dist/distributions.d.mts",
        "require": "./dist/distributions.d.cts"
      },
      "import": "./dist/distributions.mjs",
      "require": "./dist/distributions.cjs"
    },
    "./engines": {
      "types": {
        "import": "./dist/engines.d.mts",
        "require": "./dist/engines.d.cts"
      },
      "import": "./dist/engines.mjs",
      "require": "./dist/engines.cjs"
    },
    "./hash": {
      "types": {
        "import": "./dist/hash.d.mts",
        "require": "./dist/hash.d.cts"
      },
      "import": "./dist/hash.mjs",
      "require": "./dist/hash.cjs"
    },
    "./nanoid": {
      "types": {
        "import": "./dist/nanoid.d.mts",
        "require": "./dist/nanoid.d.cts"
      },
      "import": "./dist/nanoid.mjs",
      "require": "./dist/nanoid.cjs"
    },
    "./secure": {
      "types": {
        "import": "./dist/secure.d.mts",
        "require": "./dist/secure.d.cts"
      },
      "import": "./dist/secure.mjs",
      "require": "./dist/secure.cjs"
    },
    "./time": {
      "types": {
        "import": "./dist/time.d.mts",
        "require": "./dist/time.d.cts"
      },
      "import": "./dist/time.mjs",
      "require": "./dist/time.cjs"
    },
    "./token": {
      "types": {
        "import": "./dist/token.d.mts",
        "require": "./dist/token.d.cts"
      },
      "import": "./dist/token.mjs",
      "require": "./dist/token.cjs"
    },
    "./ulid": {
      "types": {
        "import": "./dist/ulid.d.mts",
        "require": "./dist/ulid.d.cts"
      },
      "import": "./dist/ulid.mjs",
      "require": "./dist/ulid.cjs"
    },
    "./unicode": {
      "types": {
        "import": "./dist/unicode.d.mts",
        "require": "./dist/unicode.d.cts"
      },
      "import": "./dist/unicode.mjs",
      "require": "./dist/unicode.cjs"
    },
    "./uuid": {
      "types": {
        "import": "./dist/uuid.d.mts",
        "require": "./dist/uuid.d.cts"
      },
      "import": "./dist/uuid.mjs",
      "require": "./dist/uuid.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "build": "npm run sync:exports && tsdown",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check": "prettier --write . && eslint --fix .",
    "ci": "prettier --check . && eslint . && node scripts/check-language.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build",
    "sync:exports": "node scripts/sync-exports.mjs",
    "check:exports": "node scripts/sync-exports.mjs --check",
    "check:types": "attw --pack .",
    "docs": "pnpm --filter ransu-docs dev",
    "docs:build": "pnpm --filter ransu-docs build && node scripts/prune-docs-assets.mjs",
    "docs:deploy": "pnpm docs:build && pnpm --filter ransu-docs exec wrangler deploy",
    "bench": "node scripts/bench.mjs",
    "test:stat": "vitest run --project statistical",
    "test:all": "vitest run",
    "check:language": "node scripts/check-language.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.22.0"
}
